# aSocialAuth – Social login plugin for Evolution CMS
# Copy the relevant lines into your Evolution CMS .env file.
# All variables are optional; providers are only shown when *_ENABLED=true
# AND the corresponding client credentials are non-empty.

# ──────────────────────────────────────────────
# Master switch
# ──────────────────────────────────────────────
ASOCIALAUTH_ENABLED=false

# ──────────────────────────────────────────────
# User creation policy
# ──────────────────────────────────────────────
# When false (default) only existing manager users can log in via social auth.
# When true a new manager account is auto-created from the social profile.
# WARNING: enabling this grants manager access to anyone with a valid social
# account whose email doesn't already exist in your manager_users table.
ASOCIALAUTH_CREATE_USERS=false

# Role ID assigned to auto-created users (only used when CREATE_USERS=true).
# Default 3 is typically a limited role in Evolution CMS.
ASOCIALAUTH_DEFAULT_ROLE=3

# ──────────────────────────────────────────────
# Google OAuth 2.0
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://yoursite.com/asocialauth/google/callback
# ──────────────────────────────────────────────
ASOCIALAUTH_GOOGLE_ENABLED=false
ASOCIALAUTH_GOOGLE_CLIENT_ID=
ASOCIALAUTH_GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Facebook / Meta OAuth 2.0
# https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: https://yoursite.com/asocialauth/facebook/callback
# ──────────────────────────────────────────────
ASOCIALAUTH_FACEBOOK_ENABLED=false
ASOCIALAUTH_FACEBOOK_CLIENT_ID=
ASOCIALAUTH_FACEBOOK_CLIENT_SECRET=

# ──────────────────────────────────────────────
# LinkedIn OAuth 2.0
# https://www.linkedin.com/developers/apps
# Authorised redirect URL: https://yoursite.com/asocialauth/linkedin/callback
# ──────────────────────────────────────────────
ASOCIALAUTH_LINKEDIN_ENABLED=false
ASOCIALAUTH_LINKEDIN_CLIENT_ID=
ASOCIALAUTH_LINKEDIN_CLIENT_SECRET=

# ──────────────────────────────────────────────
# X (Twitter) OAuth 2.0
# https://developer.x.com/en/portal/dashboard
# Callback URI: https://yoursite.com/asocialauth/x/callback
# Note: email access requires "Request email from users" enabled in the app
# settings AND the scope "users.email" (already included by default).
# ──────────────────────────────────────────────
ASOCIALAUTH_X_ENABLED=false
ASOCIALAUTH_X_CLIENT_ID=
ASOCIALAUTH_X_CLIENT_SECRET=
